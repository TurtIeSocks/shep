---
/*
 * The landing page (docs/shep-design/README.md, "Screens > 1. Landing
 * page"; design-files/Shep Landing v3 scene.dc.html is the pixel source).
 * Structure: Nav, then one SkyStage wrapper (the sticky-pasture trick —
 * see that component's own doc comment) holding the five content scenes
 * and the lexicon section, then three independent bands in normal flow:
 * features, chalkboard, CTA footer.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/landing/Nav.astro";
import SkyStage from "../components/landing/SkyStage.astro";
import Scene1Hero from "../components/landing/scenes/Scene1Hero.astro";
import Scene2Flock from "../components/landing/scenes/Scene2Flock.astro";
import Scene3Flockfile from "../components/landing/scenes/Scene3Flockfile.astro";
import Scene4Dogs from "../components/landing/scenes/Scene4Dogs.astro";
import Scene5PreRelease from "../components/landing/scenes/Scene5PreRelease.astro";
import Lexicon from "../components/landing/Lexicon.astro";
import Features from "../components/landing/Features.astro";
import Chalkboard from "../components/landing/Chalkboard.astro";
import CtaFooter from "../components/landing/CtaFooter.astro";
---

<Base
  title="shep · a process manager for your flock"
  description="A process manager written in Rust. One binary runs a daemon called the shepherd, which keeps a flock of your long-running processes alive — restarting them when they die, capturing what they print, and saying plainly when something is wrong."
  theme="light"
>
  <Nav />
  <SkyStage>
    <Scene1Hero />
    <Scene2Flock />
    <Scene3Flockfile />
    <Scene4Dogs />
    <Scene5PreRelease />
    <Lexicon />
  </SkyStage>
  <Features />
  <Chalkboard />
  <CtaFooter />
</Base>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
