  { pm2: "pm2 sendSignal", shep: "shep signal" },
  { pm2: "-", shep: "shep whisper", note: "no pm2 equivalent: writes a line to an app's stdin" },
  {
    pm2: "pm2 trigger",
    shep: "shep trigger",
    note: "different mechanism: pm2 calls a module method, shep sends over the app's own shepherd channel",
  },
  {
    pm2: "pm2 monit",
    shep: "shep lookout",
    note: "alias: dash (a fuller dashboard, not a straight swap)",
  },
  { pm2: "-", shep: "shep enable / disable / adopt / rehome", note: "dogs have no pm2 analogue" },
  { pm2: "-", shep: "shep set / get / unset", note: "the KV store; nothing in pm2 does this" },
];
