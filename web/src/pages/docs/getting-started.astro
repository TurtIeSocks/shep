    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 0 18px;
  }

  .fine {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0 0 40px;
  }

  .terminal {
    background: var(--illus-terminal-bg);
    border: 3px solid var(--line);
    border-radius: 16px;
    padding: 20px 22px;
    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--illus-terminal-text);
    overflow-x: auto;
    white-space: pre;
    margin: 0 0 12px;
  }

  .terminal.json {
    font-size: 13px;
    line-height: 1.85;
    margin: 0 0 40px;
  }

  .terminal .prompt,
  .terminal .ok {
    color: var(--grass);
  }

  .terminal .muted {
    color: var(--illus-terminal-muted);
  }

  .terminal .key {
    color: var(--sky);
  }

  .terminal .num,
  .terminal .s {
    color: var(--grass);
  }

  .terminal .nul {
    color: var(--bark);
  }

  .file-panel {
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    margin: 0 0 18px;
  }

  .file-name {
    padding: 12px 18px;
    border-bottom: 2px solid var(--hair);
    font-family: "Space Mono", monospace;
    font-size: 12.5px;
    font-weight: 700;
  }

  .file-body {
    padding: 20px 22px;
    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--ink-2);
    overflow-x: auto;
  }

  .file-body .bark-line {
    color: var(--bark);
  }

  .file-body .str {
    color: var(--meadow);
  }

  .alias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
    margin: 0 0 40px;
  }

  .alias-card {
    background: var(--paper-2);
    border: 2.5px solid var(--hair);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .alias-card .themed {
    font-family: "Space Mono", monospace;
    font-size: 14px;
    font-weight: 700;
    color: var(--meadow);
  }

  .alias-card .plain {
    font-family: "Space Mono", monospace;
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 5px;
  }

  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .next-card {
    text-align: left;
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow: 5px 5px 0 var(--shadow);
    padding: 20px;
    color: var(--ink);
    text-decoration: none;
    display: block;
  }

  .next-card:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--shadow);
    color: var(--ink);
  }

  .next-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 17px;
    margin-bottom: 7px;
  }

  .next-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
