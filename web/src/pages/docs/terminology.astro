---
/*
 * Terminology (docs/shep-design/README.md, "Screens > 2. Docs >
 * Terminology"). The lexicon table is DATA from web/src/data/docsLexicon.ts
 * (parsed from web/src/data/lexiconTable.md at build time, which is the file
 * to edit to change a row — see that parser's header comment for why it is
 * not docs/terminology.md).
 * The usage-rule cards are DATA from web/src/data/docsRules.ts.
 */
import DocsLayout from "../../layouts/DocsLayout.astro";
import ReferencePills from "../../components/docs/ReferencePills.astro";
import { lexiconTable, mdInlineToHtml } from "../../data/docsLexicon";
import { usageRules } from "../../data/docsRules";

const toneFor = (built: "yes" | "partly" | "no") =>
  built === "yes"
    ? "var(--meadow)"
    : built === "partly"
      ? "var(--butter)"
      : "var(--bark)";
---

<DocsLayout
  title="Terminology"
  description="The full shep lexicon: what each themed word means, where you meet it, and whether it's built yet."
  crumb="Concepts / Terminology"
  activeSlug="terminology"
>
  <article>
    <h1>Terminology</h1>
    <ReferencePills slug="terminology" />
    <p class="lede">
      The vocabulary is not decoration. A process manager gives you a lot of
      nouns to keep straight, and sheep are a better mnemonic than "target
      group" or "managed unit".
    </p>
    <p class="lede lede-last">
      Where the joke would cost clarity it gets dropped: <code>kill</code> is
      called kill, error messages are written in plain technical English,
      and every themed verb has a straight alias that works forever.
    </p>

    <h2>The lexicon</h2>
    <div class="lexicon-table">
      <div class="row header">
        <span class="col-term">shep says</span>{" "}
        <span class="col-means">means</span>{" "}
        <span class="col-where">where you meet it</span>{" "}
        <span class="col-built" data-pagefind-ignore>built</span>
      </div>
      {
        lexiconTable.map((row) => (
          <div class="row">
            <span class="col-term term">{row.term}</span>{" "}
            <span class="col-means" set:html={mdInlineToHtml(row.means)} />{" "}
            <span class="col-where" set:html={mdInlineToHtml(row.where)} />{" "}
            <span
              class="col-built"
              data-pagefind-ignore
              style={`color:${toneFor(row.built)}`}
            >
              {row.built}
            </span>
          </div>
        ))
      }
    </div>

    <div class="sheepdogs-card">
      <h3>Sheepdogs and sheep were separate ideas from the start</h3>
      <p>
        So "dog" never means the daemon. The shepherd is the shepherd. Dogs
        are plugins that work for it: <code>metrics</code> and
        <code>bark</code> ship inside the binary, and
        <code>shep adopt</code> runs anyone else's.
      </p>
    </div>

    <h2>Usage rules</h2>
    <p class="rules-lede">Readability beats theme, every time.</p>
    <div class="rules">
      {
        usageRules.map((rule, i) => (
          <div class="rule">
            <span class="n">{i + 1}</span>
            <div>
              <div class="rule-title">{rule.title}</div>
              <p>{rule.body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h2>Where to go next</h2>
    <div class="next-grid">
      <a href="/docs/first-flockfile" class="next-card">
        <div class="next-title">Your first Flockfile →</div>
        <div class="next-body">
          Put the vocabulary to work: every field, in the config that
          actually uses these words.
        </div>
      </a>
      <a href="/docs/folds" class="next-card">
        <div class="next-title">Folds →</div>
        <div class="next-body">
          One of the words above, worked through on its own: what a fold is,
          and what it deliberately isn't.
        </div>
      </a>
    </div>
  </article>
</DocsLayout>

<style>
  h1 {
    font-size: clamp(36px, 4.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 18px;
  }

  h2 {
    font-size: 29px;
    letter-spacing: -0.03em;
    margin: 40px 0 18px;
  }

  h2:first-of-type {
    margin-top: 0;
  }

  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .lede-last {
    margin-bottom: 34px;
  }

  .lexicon-table {
    border: 3px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    margin: 0 0 40px;
  }

  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1.1fr) minmax(0, 1.1fr) 74px;
    gap: 14px;
    padding: 14px 20px;
    align-items: start;
  }

  .row.header {
    padding: 13px 20px;
    background: var(--ink);
  }

  .row:not(.header) {
    border-bottom: 2px solid var(--hair);
    background: var(--paper-2);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row.header span {
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .row.header .col-term {
    color: var(--butter);
  }

  .row.header .col-built {
    text-align: right;
  }

  .term {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 15.5px;
    color: var(--meadow);
    line-height: 1.3;
  }

  .col-means {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
  }

  .col-where {
    font-family: "Space Mono", monospace;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .row:not(.header) .col-built {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .row.header {
      display: none;
    }

    .col-built {
      text-align: left !important;
    }
  }

  .sheepdogs-card {
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 18px;
    padding: 24px 26px;
    margin: 0 0 40px;
  }

  .sheepdogs-card h3 {
    font-size: 20px;
    margin: 0 0 10px;
  }

  .sheepdogs-card p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .rules-lede {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 0 22px;
  }

  .rules {
    display: grid;
    gap: 14px;
  }

  .rule {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    background: var(--paper-2);
    border: 2.5px solid var(--hair);
    border-radius: 16px;
    padding: 20px;
  }

  .rule .n {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: var(--bark);
  }

  .rule-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 17px;
    margin-bottom: 6px;
  }

  .rule p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 36px;
  }

  .next-card {
    text-align: left;
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow: 5px 5px 0 var(--shadow);
    padding: 20px;
    color: var(--ink);
    text-decoration: none;
    display: block;
  }

  .next-card:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--shadow);
    color: var(--ink);
  }

  .next-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 17px;
    margin-bottom: 7px;
  }

  .next-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
