---
/*
 * Inline "not built yet" marker, for a single feature mentioned in passing
 * on an otherwise-real page (e.g. "lookout ships all four panes; search
 * and filter <NotBuilt /> don't exist yet") — a claim inside a finished
 * page, not a whole unwritten one; every /docs/* page is written today, so
 * there's no page-level stub component to compare it against.
 *
 * Usage: <NotBuilt /> for the bare pill, or <NotBuilt note="v1.1+" /> to
 * append a short reason inline.
 */
interface Props {
  note?: string;
}

const { note } = Astro.props;
---

<span class="not-built">
  not built yet
  {note && <span class="note"> — {note}</span>}
</span>

<style>
  .not-built {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-family: "Space Mono", monospace;
    font-size: 0.82em;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bark);
    border: 2px solid var(--bark);
    border-radius: 7px;
    padding: 1px 8px;
    white-space: nowrap;
  }

  .note {
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    white-space: normal;
  }
</style>
