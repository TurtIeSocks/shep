---
/*
 * Docs sidebar (docs/shep-design/README.md, "Screens > 2. Docs > Sidebar").
 * Three groups from web/src/data/docsNav.ts. Active item: butter fill, ink
 * text, 700 weight, 2px ink border. Inactive: transparent, --ink-2, 400.
 * Unbuilt items carry a "soon" tag in bark on the right.
 *
 * Mobile (below 860px, the width DocsLayout.astro collapses the sidebar
 * column at): the handoff calls a fixed 264px column beside an 860px
 * article the biggest unsolved gap and asks for "a collapsible docs
 * sidebar" as one real option. This is that — a native <details>/<summary>
 * disclosure, collapsed by default so a phone visitor sees the article
 * almost immediately instead of scrolling past ten nav links first, with a
 * "Menu" bar that expands the same three groups in place.
 *
 * No client JS: <details> is natively keyboard- and screen-reader-operable
 * as a disclosure widget, so this needs no toggle script and keeps working
 * with JS disabled. Desktop forces the content permanently open at >=861px
 * with two rules, both needed: `.sidebar-content { display: block }` beats
 * the old UA default (`details:not([open]) > *:not(summary){display:none}`)
 * on engines that still use it, but modern Chromium wraps the content in a
 * `::details-content` pseudo-element carrying its own
 * `content-visibility: hidden` while closed, which a descendant's
 * `display: block` cannot override — `.docs-sidebar::details-content {
 * content-visibility: visible }` is what actually beats that. Confirmed by
 * looking at a real desktop viewport, not just by reading the spec.
 */
import { docsNav } from "../../data/docsNav";

interface Props {
  activeSlug: string;
}

const { activeSlug } = Astro.props;
---

<details class="docs-sidebar">
  <summary class="menu-toggle">
    <span>Menu</span>
    <svg class="chevron" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 4.5 7 9.5 12 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <div class="sidebar-content">
    {
      docsNav.map((group) => (
        <div class="group">
          <div class="group-label">{group.label}</div>
          <div class="items">
            {group.items.map((item) => {
              const active = item.slug === activeSlug;
              return (
                <a
                  href={`/docs/${item.slug}`}
                  class:list={["item", active && "active"]}
                >
                  <span>{item.label}</span>
                  {!item.built && <span class="tag">soon</span>}
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
    <div class="footnote">
      Docs track the repo. Anything marked <span class="mono">soon</span>{" "}
      exists in <span class="mono">/docs</span> but hasn't been brought over
      yet.
    </div>
  </div>
</details>

<style>
  .docs-sidebar {
    position: sticky;
    top: 64px;
    padding: 34px 24px 60px;
    border-right: 3px solid var(--line);
    min-height: calc(100vh - 64px);
  }

  .menu-toggle {
    display: none;
  }

  .group {
    margin-bottom: 28px;
  }

  .group-label {
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 12px;
  }

  .items {
    display: grid;
    gap: 3px;
  }

  .item {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 400;
    font-size: 14.5px;
    text-align: left;
    background: transparent;
    color: var(--ink-2);
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 8px 11px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-decoration: none;
  }

  .item:hover {
    border-color: var(--hair);
    color: var(--ink-2);
  }

  .item.active {
    font-weight: 700;
    background: var(--butter);
    color: var(--ink);
    border-color: var(--line);
  }

  .item.active:hover {
    color: var(--ink);
  }

  .tag {
    font-family: "Space Mono", monospace;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bark);
  }

  .footnote {
    border-top: 2px solid var(--hair);
    padding-top: 18px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .mono {
    font-family: "Space Mono", monospace;
  }

  /* Desktop: ignore the <details> open/closed state entirely and always
     show the nav — see the component doc comment for why this plain
     selector is enough to beat the browser's own hiding rule. */
  @media (min-width: 861px) {
    .sidebar-content {
      display: block;
    }

    /* Modern Chromium wraps <details> content in a ::details-content
       pseudo-element that carries its own `content-visibility: hidden`
       while the element is closed — a `display: block` on a descendant
       cannot override that. This rule targets the pseudo-element itself
       so the content actually paints on desktop; engines without it just
       ignore an unknown pseudo-element and fall back to the rule above. */
    .docs-sidebar::details-content {
      content-visibility: visible;
      block-size: auto;
    }
  }

  @media (max-width: 860px) {
    .docs-sidebar {
      position: static;
      min-height: 0;
      border-right: none;
      border-bottom: 3px solid var(--line);
      padding: 0;
    }

    /* Kill the default disclosure triangle so .chevron is the only marker. */
    .docs-sidebar summary {
      list-style: none;
    }

    .docs-sidebar summary::-webkit-details-marker {
      display: none;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 16px 20px;
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
    }

    .chevron {
      color: var(--ink-3);
      transition: transform 0.15s ease;
      flex: none;
    }

    .docs-sidebar[open] .chevron {
      transform: rotate(180deg);
    }

    .sidebar-content {
      padding: 4px 20px 24px;
      border-top: 2px solid var(--hair);
    }
  }
</style>
