---
/*
 * The landing page's structural trick (docs/shep-design/README.md,
 * "Landing page > Structure" table + the top-level "THE STRUCTURAL TRICK"
 * note). One relative wrapper holds, in z-order:
 *
 *   0  fixed sky gradient spanning the whole stage (night -> dawn -> noon)
 *   1  stars / moon / sun / sheep-clouds, positioned in vh down the stage
 *   2  a STICKY pasture (position:sticky; top:0; height:100vh;
 *      margin-bottom:-100vh) so the scenery pins while content scrolls —
 *      since build 4 it also carries a band of dawn fog over the far hill
 *   3  a night wash that multiplies over the top and fades out
 *   4  a barn glow, second sticky layer
 *   5+ <slot /> — the five content scenes, the lexicon, features,
 *      chalkboard and CTA footer: everything below the nav lives INSIDE
 *      this wrapper, because the stage's total height (driven by slotted
 *      content) is what the sticky pasture pins against, and the sections
 *      are transparent so the scene runs behind them to the footer.
 *
 * Scroll is the passage of time here (night -> dawn -> noon), and the sky
 * plays it out: stars, moon, sun and clouds each scroll at their own
 * fraction of content speed, the night sky dissolves as the dawn comes up,
 * and time-based ambients (cloud sway, shooting stars, sun/moon glow) keep
 * the scene breathing even when the page is still. See THE SPEED MODEL
 * comment above the parallax rules at the bottom of this file for the whole
 * choreography and how to tune it.
 */
import Sheep from "../marks/Sheep.astro";
import Dog from "../marks/Dog.astro";
import Barn from "../marks/Barn.astro";

const stars = [
  [8, 14, 3, 3.1], [16, 38, 2, 4.2], [24, 8, 2.5, 2.6], [33, 24, 3, 3.8], [41, 7, 2, 4.6],
  [49, 30, 2.5, 3.2], [57, 13, 3, 2.9], [64, 35, 2, 4.1], [72, 9, 2.5, 3.5], [79, 27, 3, 2.7],
  [86, 16, 2, 4.4], [92, 38, 2.5, 3.3], [12, 52, 2, 3.9], [68, 56, 2.5, 4.8],
  [37, 62, 2, 3.4], [83, 66, 2.5, 4.1], [22, 72, 2, 3.7], [58, 78, 2, 4.5],
].map(([x, y, d, dur]) => ({ x, y, d, dur }));

const posts = [30, 180, 330, 480, 630, 780, 930, 1080, 1230, 1350];

/*
 * Clouds used to sit at raw viewport percentages, so at ordinary widths
 * (below ~1240px, where .inner's max-width isn't yet centering the page)
 * they landed inside the scene column's own horizontal span and hid behind
 * the lede. left/right below are no longer viewport-relative: `.clouds`
 * (see its rule below) is inset from the LEFT by --col-right, the widest
 * scene column's actual right edge at the current width, computed with the
 * same max-width/columnWidth math SceneSection.astro uses. So these
 * percentages are of the safe zone to the right of every scene's text, and
 * a cloud can never land under copy at any width.
 *
 * `speed` is the fraction of content speed the cloud scrolls at while on
 * screen (THE SPEED MODEL, in the stylesheet below): near, big clouds run
 * fast (0.75), far, small ones slow (0.4) — depth comes from the SPREAD of
 * those rates, not from any one of them. `wind` is the time-based sideways
 * sway of the puff itself; amplitude and period also scale with depth
 * (near = bigger and faster), and the negative delays start each cloud
 * mid-cycle so no two ever sway in sync (motion.css's lockstep rule).
 *
 * Clouds visible before any scrolling happens can't run on a view()
 * timeline (`atTop`, see `.cloud.at-top` below). Their `spanVh` is the
 * document top-to-bottom-edge extent — top position plus own height —
 * the figure the scroll(root) range is derived from.
 *
 * Variety comes from three knobs so every puff stays the one handoff
 * silhouette rather than new artwork: `squash` scales the height only
 * (the svg renders with preserveAspectRatio="none", so a 0.8 is a long
 * flat drifter and a 1.12 a taller cumulus — at 3.4px the stroke's
 * non-uniform scaling is imperceptible), `mirror` flips the path inside
 * the svg (an attribute transform, because CSS transforms on the svg
 * element belong to the wind sway), and the two farthest clouds drop a
 * little opacity to lose contrast the way the far sheep do.
 */
interface CloudSpec {
  left?: string;
  right?: string;
  top: string;
  width: string;
  speed: number;
  atTop?: { spanVh: number };
  squash?: number;
  mirror?: boolean;
  opacity?: number;
  wind: { amp: string; duration: string; delay: string };
}

const clouds: CloudSpec[] = [
  {
    left: "6%",
    top: "52vh",
    width: "150px",
    speed: 0.6,
    atTop: { spanVh: 63 },
    wind: { amp: "10px", duration: "23s", delay: "-7s" },
  },
  {
    right: "24%",
    top: "30vh",
    width: "88px",
    speed: 0.45,
    atTop: { spanVh: 36 },
    squash: 0.82,
    mirror: true,
    opacity: 0.9,
    wind: { amp: "7px", duration: "29s", delay: "-13s" },
  },
  {
    right: "18%",
    top: "128vh",
    width: "112px",
    speed: 0.5,
    squash: 0.85,
    wind: { amp: "9px", duration: "26s", delay: "-3s" },
  },
  {
    left: "38%",
    top: "262vh",
    width: "205px",
    speed: 0.78,
    mirror: true,
    wind: { amp: "17px", duration: "16s", delay: "-11s" },
  },
  {
    right: "10%",
    top: "332vh",
    width: "132px",
    speed: 0.6,
    squash: 1.12,
    wind: { amp: "12px", duration: "21s", delay: "-15s" },
  },
  {
    left: "20%",
    top: "392vh",
    width: "84px",
    speed: 0.4,
    squash: 0.8,
    opacity: 0.88,
    wind: { amp: "7px", duration: "31s", delay: "-5s" },
  },
];

/*
 * Turn a cloud's authored `speed` into the custom properties the drift
 * animations consume — the two formulas from THE SPEED MODEL, computed here
 * so the tuning knob stays the single speed number above.
 */
/*
 * Roaming animals cross the entire pasture and walk off screen while others
 * walk on (the `roam` keyframes in motion.css — negative delays start each
 * one mid-journey so the pasture is never suddenly empty at load). Fleece
 * colors are illustration literals like the marks' own: a moorit-brown ewe
 * trailing a white lamb up front, a black sheep and a white ewe with a
 * brown lamb far back. Lambs gambol instead of bobbing. The far groups take
 * the same desaturate/brighten treatment and behind-the-fence z-index as
 * the far grazer; widths are clamp()ed in the styles below, per depth and
 * per adult/lamb, for the same footprint-shrinks-with-viewport reason.
 */
interface RoamerSpec {
  depth: "mid" | "far";
  from: string;
  to: string;
  facingRight: boolean;
  duration: string;
  delay: string;
  bottom: string;
  width: number;
  fleece?: string;
  bobDuration: string;
  bobDelay: string;
  lamb?: { width: number; fleece?: string; gambolDuration: string };
}

const roaming: RoamerSpec[] = [
  {
    depth: "mid",
    from: "-28vw",
    to: "108vw",
    facingRight: true,
    duration: "95s",
    delay: "-34s",
    bottom: "4.5vh",
    width: 64,
    fleece: "#b5895f",
    bobDuration: "5.1s",
    bobDelay: ".6s",
    lamb: { width: 36, gambolDuration: "1.15s" },
  },
  {
    depth: "far",
    from: "108vw",
    to: "-28vw",
    facingRight: false,
    duration: "128s",
    delay: "-58s",
    bottom: "17vh",
    width: 48,
    fleece: "#4b463d",
    bobDuration: "6.2s",
    bobDelay: ".2s",
  },
  {
    depth: "far",
    from: "-28vw",
    to: "108vw",
    facingRight: true,
    duration: "152s",
    delay: "-118s",
    bottom: "20vh",
    width: 44,
    bobDuration: "6.9s",
    bobDelay: ".9s",
    lamb: { width: 28, fleece: "#b5895f", gambolDuration: "0.95s" },
  },
];

const cloudMotion = (c: CloudSpec) => {
  const wind = `--wind-amp:${c.wind.amp};--wind-duration:${c.wind.duration};--wind-delay:${c.wind.delay};`;
  if (c.atTop) {
    const range = c.atTop.spanVh / c.speed;
    return `--parallax-drift:${(range - c.atTop.spanVh).toFixed(1)}vh;--parallax-range:${range.toFixed(1)}vh;${wind}`;
  }
  const drift = (100 * (1 - c.speed)) / c.speed;
  return `--parallax-drift:${drift.toFixed(1)}vh;--parallax-range-end:${(100 / c.speed).toFixed(1)}%;${wind}`;
};

/*
 * Depth for the grazing sheep: far/mid/near controls width (a clamp() in
 * the stylesheet, not a fixed px, so the footprint itself shrinks with the
 * viewport instead of only its position), walk speed, height against the
 * hill, and z-index (the far sheep paints behind .fence — see that rule).
 * left/bottom are home positions; --walk-amp is how far each one wanders
 * from home before turning back (see the `walk` keyframes in motion.css).
 * These lanes plus the dog's fixed spot were checked against each other at
 * 320px — the tightest width, since every sheep's clamp() is pinned to its
 * min there — with a positive clearance margin at every boundary; wider
 * viewports only add more room. See the .depth-* / .watch-dog rules below.
 */
const grazing = [
  {
    depth: "far",
    left: "10%",
    bottom: "16vh",
    width: 52,
    bobDuration: "6.8s",
    bobDelay: ".3s",
    chewing: false,
    walkAmp: "2.5vw",
    walkDuration: "34s",
    walkDelay: "0s",
  },
  {
    depth: "mid",
    left: "30%",
    // 3vh, not the original 8vh: at 8vh the mid sheep's feet landed inside
    // .fence's own band (bottom:7vh/54px tall, or bottom:4vh below 600px) at
    // ordinary viewport heights, painting its legs directly over a rail
    // since depth-mid is in front (z-index 3 > the fence's 2) — it read as
    // standing on the fence. 3vh keeps its feet below the fence's bottom
    // edge at both breakpoints (matching how the near sheep already clears
    // it: its feet sit well past the fence's bottom rather than at the same
    // height as a rail), while its back still rises in front of the fence
    // as it walks past — a clean occlusion, not a coincidental balance.
    bottom: "3vh",
    width: 72,
    bobDuration: "5.6s",
    bobDelay: ".8s",
    chewing: true,
    walkAmp: "2vw",
    walkDuration: "24s",
    walkDelay: "1.4s",
  },
  {
    depth: "near",
    left: "52%",
    bottom: "2vh",
    width: 92,
    bobDuration: "4.8s",
    bobDelay: "0s",
    chewing: false,
    walkAmp: "2.5vw",
    walkDuration: "17s",
    walkDelay: "2.6s",
  },
];
---

<div class="stage">
  <div class="sky-gradient"></div>

  <div class="stars">
    {stars.map((s) => (
      <span
        class="star anim-twinkle"
        style={`left:${s.x}%;top:${s.y}%;width:${s.d}px;height:${s.d}px;--twinkle-duration:${s.dur}s;`}
      />
    ))}
    <span
      class="shooting-star"
      style="left:64%;top:18%;--shoot-duration:9.5s;--shoot-delay:2.8s;"
    />
    <span
      class="shooting-star"
      style="left:28%;top:44%;--shoot-duration:14s;--shoot-delay:8.4s;"
    />
  </div>

  <div class="moon">
    <span class="crater" style="left:21px;top:29px;width:17px;height:17px;" />
    <span class="crater" style="left:55px;top:21px;width:12px;height:12px;" />
    <span class="crater" style="left:45px;top:58px;width:21px;height:21px;" />
  </div>

  <div class="sun" aria-hidden="true"></div>

  <div class="clouds">
    {clouds.map((c) => (
      <div
        class={`cloud${c.atTop ? " at-top" : ""}`}
        style={`${c.left ? `left:${c.left};` : `right:${c.right};`}top:${c.top};width:${c.width};aspect-ratio:${(104 / 78 / (c.squash ?? 1)).toFixed(3)};${c.opacity ? `opacity:${c.opacity};` : ""}${cloudMotion(c)}`}
      >
        <svg
          viewBox="0 0 104 78"
          width="100%"
          height="100%"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <g transform={c.mirror ? "translate(104 0) scale(-1 1)" : undefined}>
            <path
              d="M40 20c6-9 22-10 28-2 10-3 19 4 18 13 7 4 7 15-1 19-2 8-12 11-19 8-8 5-21 4-26-3-10 1-17-7-15-16-4-8 4-18 15-19Z"
              fill="var(--fleece)"
              stroke="var(--ink)"
              stroke-width="3.4"
              stroke-linejoin="round"
            />
          </g>
        </svg>
      </div>
    ))}
  </div>

  <div class="pasture" aria-hidden="true">
    <div class="far-hill">
      <svg viewBox="0 0 1200 210" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 118C170 62 360 132 560 104 760 76 950 30 1200 84V210H0Z"
          fill="var(--illus-far-hill)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="barn">
      <Barn width={300} />
    </div>

    <div class="mist"></div>

    <div class="near-hill">
      <svg viewBox="0 0 1200 260" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 92C220 52 470 116 700 88 930 60 1050 96 1200 70V260H0Z"
          fill="var(--grass)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="fence">
      <svg viewBox="0 0 1400 76" preserveAspectRatio="none" width="100%" height="100%">
        <g fill="var(--fleece)" stroke="var(--ink)" stroke-width="4">
          <rect x="0" y="22" width="1400" height="12" rx="3" />
          <rect x="0" y="48" width="1400" height="12" rx="3" />
          {posts.map((a) => <path d={`M${a} 74V14l14-10 14 10v60Z`} />)}
        </g>
      </svg>
    </div>

    {grazing.map((sheep) => (
      <div
        class={`grazing-sheep depth-${sheep.depth} anim-walk`}
        style={`left:${sheep.left};bottom:${sheep.bottom};--walk-amp:${sheep.walkAmp};--walk-duration:${sheep.walkDuration};--walk-delay:${sheep.walkDelay};`}
      >
        <Sheep
          width={sheep.width}
          bob
          bobDuration={sheep.bobDuration}
          bobDelay={sheep.bobDelay}
          chewing={sheep.chewing}
        />
      </div>
    ))}

    <div class="watch-dog">
      <Dog width={126} wag />
    </div>

    {roaming.map((r) => (
      <div
        class={`roamer roamer-${r.depth} anim-roam`}
        style={`bottom:${r.bottom};--roam-from:${r.from};--roam-to:${r.to};--roam-duration:${r.duration};--roam-delay:${r.delay};`}
      >
        <div class="trek" style={r.facingRight ? "transform:scaleX(-1);" : undefined}>
          <Sheep
            width={r.width}
            fleece={r.fleece}
            bob
            bobDuration={r.bobDuration}
            bobDelay={r.bobDelay}
          />
          {r.lamb && (
            <div class="lamb" style={`--gambol-duration:${r.lamb.gambolDuration};`}>
              <Sheep width={r.lamb.width} fleece={r.lamb.fleece} class="anim-gambol" />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="night-wash"></div>

  <div class="barn-glow-layer">
    <div class="barn-glow"></div>
  </div>

  <slot />
</div>

<style>
  .stage {
    position: relative;
    /* Belt-and-braces against horizontal scroll from decorative overhang
       (first offender: the sun's ::before halo past the right edge at
       narrow widths). `clip`, never `hidden`: hidden would make the stage
       a scroll container and silently kill the sticky pasture — the bug
       that flattened the whole scroll effect once already — while clip
       only clips paint and creates no scroll container, leaving sticky
       and the scroll-driven timelines alone. */
    overflow-x: clip;
    /*
     * Mirrors SceneSection.astro's own layout math (.inner's max-width and
     * padding, and the widest columnWidth of the five scenes — Scene2's
     * min(660px,56vw)) so --col-right always lands on the actual right edge
     * of the widest scene column at the current viewport width. Anything
     * placed at left:var(--col-right) or further right is guaranteed clear
     * of every scene's copy, at every width, instead of by coincidence.
     */
    --inner-max: 1240px;
    --inner-pad: 28px;
    --col-cap: 660px;
    --col-vw: 56vw;
    --inner-left: max(
      var(--inner-pad),
      calc((100vw - var(--inner-max)) / 2 + var(--inner-pad))
    );
    --col-right: calc(var(--inner-left) + min(var(--col-cap), var(--col-vw)));
  }

  @media (max-width: 680px) {
    /* SceneSection.astro forces every column to min(92vw,520px) below this
       same breakpoint — match it so --col-right stays accurate. */
    .stage {
      --col-cap: 520px;
      --col-vw: 92vw;
    }
  }

  .sky-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    /*
     * Stops rescaled x0.743 from the original five-scene calibration when
     * the lexicon/features/chalkboard/CTA sections moved inside the stage
     * (stage 5484px -> 7380px at the 1440x900 tuning baseline): the same
     * multiplier on every stop keeps night and dawn at the same absolute
     * scroll positions as before, and the added page tail simply extends
     * the noon hold. If more sections ever join the stage, rescale again
     * by old-stage-height / new-stage-height.
     */
    background: linear-gradient(
      180deg,
      #0e1730 0%,
      #152342 3.6%,
      #26386a 7.6%,
      #4c4a83 11.1%,
      #8c5f84 14.2%,
      #c97a5a 17.2%,
      #e7a468 20.3%,
      #f1c98d 23.3%,
      #dde6e0 27.3%,
      #bfe2f2 32.4%,
      #9bd8f1 38.5%,
      #b9e5f7 44.6%,
      #cfebf8 50.7%,
      #cfebf8 100%
    );
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 36vh;
    z-index: 1;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--fleece);
  }

  /*
   * Meteors. Base opacity 0: the streak only ever appears through its
   * time-based keyframes, so reduced-motion visitors (and anyone with
   * animations off) simply never see one — no static streak parked in the
   * sky. They live inside .stars, so they inherit its slow drift and fade,
   * and die with the night the way the stars do. The gradient runs bright
   * head (left) to transparent tail; rotate(-33deg) matches the keyframes'
   * travel vector (-190px, +123px), down-and-left toward the horizon.
   */
  .shooting-star {
    position: absolute;
    width: 110px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--fleece), rgba(255, 255, 255, 0));
    opacity: 0;
    transform: rotate(-33deg);
  }

  .moon {
    position: absolute;
    left: 17%;
    top: 9vh;
    /* 100px, up from the original 76 (crater offsets above scaled with it,
       x1.32). Its drift range stays at the 17vh-span figures — the extra
       height only means the animation completes a moment before the disc
       fully exits, and the 25-65% fade has it invisible long before that
       seam could show. */
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--illus-moon);
    border: 4px solid var(--line);
    box-shadow: 5px 5px 0 rgba(14, 23, 48, 0.35);
    z-index: 1;
  }

  .crater {
    position: absolute;
    border-radius: 50%;
    background: var(--illus-moon-craters);
    display: block;
  }

  .sun {
    position: absolute;
    left: 60%;
    /* 190vh, not the original 224vh: the disc now rises at ~0.2x (THE
       SPEED MODEL below), so it visually crests the hills about 1.5
       viewports of scroll later than a 1x sun from the same spot would.
       Placing it a third of a viewport earlier puts the crest back inside
       the orange dawn band instead of into an already-blue morning. */
    top: 190vh;
    /* Fluid, capped at 168px (up from a fixed 124): at 60% left a fixed
       disc this size would poke past a 375px viewport and horizontal
       clipping would slice it flat — 34vw keeps the whole disc on screen
       at any width, and aspect-ratio keeps it a circle. */
    width: min(168px, 34vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--butter);
    border: 4px solid var(--line);
    box-shadow: 6px 6px 0 rgba(23, 37, 28, 0.16);
    z-index: 1;
  }

  /*
   * Soft halos behind the two discs, following the barn-glow precedent for
   * radial gradients in an otherwise hard-outlined scene. Each is a child
   * pseudo-element rather than a sibling so it rides the disc's own drift
   * transform for free; z-index -1 tucks it behind the disc's fill (both
   * discs are positioned with z-index 1, so each is its own stacking
   * context and -1 cannot escape below the sky). The glows are static for
   * reduced-motion visitors — light, not movement — and only the gentle
   * breathing (glow-breathe, in the motion block below) is gated.
   */
  .moon::before,
  .sun::before {
    content: "";
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }

  .moon::before {
    inset: -52px;
    background: radial-gradient(
      circle,
      rgba(244, 240, 226, 0.45) 0%,
      rgba(244, 240, 226, 0.16) 45%,
      rgba(244, 240, 226, 0) 70%
    );
  }

  .sun::before {
    inset: -68px;
    background: radial-gradient(
      circle,
      rgba(247, 228, 176, 0.85) 0%,
      rgba(243, 196, 76, 0.36) 42%,
      rgba(243, 196, 76, 0) 70%
    );
  }

  .clouds {
    position: absolute;
    inset: 0;
    left: var(--col-right);
    z-index: 1;
    /* Clouds are placed by percentage inside this lane but carry a fixed
       pixel width, so at narrow widths one can reach past the lane's right
       edge and give the document real horizontal scroll. Clip here rather
       than on `.stage`: `.stage` also contains `.pasture`, and any overflow
       value other than `visible` or `clip` makes an ancestor a scroll
       container, which silently disables `position: sticky` for its
       descendants. That is the exact bug that flattened the whole scroll
       effect once already. `.clouds` and `.pasture` are siblings, so
       clipping stops here. A cloud cut off at the edge reads as one
       drifting out of the sky.

       `clip`, NOT `hidden`: hidden also makes this lane a scroll container,
       and view() timelines bind to their nearest scroll-container ancestor
       — with hidden here, every cloud's animation silently tracked this
       never-scrolling lane instead of the page and sat frozen at progress
       0 (which is why build 3's cloud parallax never actually moved).
       clip clips identically but creates no scroll container, so the
       timelines fall through to the root scroller. */
    overflow: clip;
  }

  .cloud {
    position: absolute;
  }

  /* Below 680px the scene column claims up to 92vw (SceneSection.astro's
     own mobile override) — there's no honest lane left for a cloud beside
     the text, so hide them deliberately rather than let them get trapped
     under copy again. Sun/moon/stars aren't scene-column-relative and are
     unaffected. */
  @media (max-width: 680px) {
    .clouds {
      display: none;
    }
  }

  .pasture {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
  }

  .far-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 8%;
    height: 43vh;
  }

  .near-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 0;
    height: 27vh;
  }

  .fence {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: 7vh;
    height: 54px;
    /* Above the hills' implicit stacking order but below the near/mid sheep
       and dog (z-index 3) — the far sheep (z-index 1) sits behind this on
       purpose, so it reads as grazing on the other side of the fence. */
    z-index: 2;
  }

  .barn {
    position: absolute;
    right: 6%;
    bottom: 26%;
    width: min(300px, 26vw);
  }

  /* Barn.astro sizes its own wrapper from the `width` prop (a fixed px
     figure for a standalone mark); here it must instead fill this
     already-responsive min(300px,26vw) container. */
  .barn :global(.barn-mark) {
    width: 100% !important;
  }

  /*
   * Dawn fog over the far hill and the barn's feet. It sits in the sticky
   * pasture between the barn and the near hill (paint order is DOM order
   * here), so the near meadow, fence and animals all stay crisp in front
   * of it while the far scenery goes hazy. Base opacity 0: it only exists
   * through its scroll-driven keyframes (mist-cycle below) — thin before
   * first light, thickest at dawn, burned off by mid-morning — so browsers
   * without scroll-driven animations, and reduced-motion visitors, never
   * see a stuck noon fog. The night wash multiplies over it (z-index 3 vs
   * the pasture's 2), which keeps it a dim grey bank before first light
   * rather than a bright cream one.
   */
  .mist {
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: 22%;
    height: 24vh;
    opacity: 0;
    background:
      radial-gradient(
        58% 60% at 22% 62%,
        rgba(251, 246, 231, 0.75),
        rgba(251, 246, 231, 0) 70%
      ),
      radial-gradient(
        46% 64% at 58% 38%,
        rgba(251, 246, 231, 0.6),
        rgba(251, 246, 231, 0) 72%
      ),
      radial-gradient(
        50% 55% at 88% 60%,
        rgba(251, 246, 231, 0.7),
        rgba(251, 246, 231, 0) 70%
      );
  }

  .grazing-sheep {
    position: absolute;
  }

  /*
   * Depth: width is a clamp() rather than the Sheep.astro `width` prop's
   * fixed px, so the footprint itself shrinks with the viewport (same fix
   * as the clouds) instead of only its position — a fixed-px sheep next to
   * a percentage lane is exactly how bug 2 happened. Further-away sheep are
   * also smaller, higher up (bigger `bottom`, set inline per-instance),
   * slower to walk, and desaturated/brightened to lose contrast against the
   * hill, plus the far one paints behind .fence (z-index 1 < fence's 2).
   */
  .depth-far {
    z-index: 1;
    filter: saturate(0.58) brightness(1.07) opacity(0.85);
  }

  .depth-far :global(.sheep-mark) {
    width: clamp(34px, 4.4vw, 58px) !important;
  }

  .depth-mid {
    z-index: 3;
  }

  .depth-mid :global(.sheep-mark) {
    width: clamp(48px, 6.2vw, 84px) !important;
  }

  .depth-near {
    z-index: 3;
  }

  .depth-near :global(.sheep-mark) {
    width: clamp(60px, 8vw, 108px) !important;
  }

  .watch-dog {
    position: absolute;
    right: 6%;
    bottom: 4vh;
    z-index: 3;
  }

  .watch-dog :global(.dog-mark) {
    width: clamp(56px, 9.4vw, 126px) !important;
  }

  /*
   * Roamers sit at left:0 and are carried across by the roam keyframes'
   * translateX; the same var(--roam-from) as a static transform keeps them
   * parked offscreen for reduced-motion visitors, who would otherwise find
   * a stranger standing in the middle of the pasture. `.trek` carries the
   * facing flip on its own element so it can't fight the roam transform,
   * and the lamb always trails its ewe: it is the second flex child, and
   * the flip mirrors the whole group, so the adult leads in both
   * directions.
   */
  .roamer {
    position: absolute;
    left: 0;
    transform: translateX(var(--roam-from, -30vw));
  }

  .trek {
    display: flex;
    align-items: flex-end;
    gap: 7px;
  }

  .roamer-mid {
    z-index: 3;
  }

  .roamer-far {
    z-index: 1;
    filter: saturate(0.58) brightness(1.07) opacity(0.85);
  }

  .roamer-mid :global(.sheep-mark) {
    width: clamp(44px, 5.6vw, 78px) !important;
  }

  .roamer-far :global(.sheep-mark) {
    width: clamp(30px, 4vw, 56px) !important;
  }

  .roamer-mid .lamb :global(.sheep-mark) {
    width: clamp(26px, 3.2vw, 42px) !important;
  }

  .roamer-far .lamb :global(.sheep-mark) {
    width: clamp(18px, 2.4vw, 32px) !important;
  }

  .night-wash {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: multiply;
    /* Stops rescaled x0.743 with the sky gradient's — see that note. */
    background: linear-gradient(
      180deg,
      rgba(16, 26, 52, 0.72) 0%,
      rgba(16, 26, 52, 0.66) 6.1%,
      rgba(22, 34, 64, 0.5) 11.1%,
      rgba(40, 40, 72, 0.3) 15.2%,
      rgba(90, 70, 60, 0.12) 19.2%,
      rgba(255, 255, 255, 0) 24.3%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .barn-glow-layer {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    z-index: 4;
    pointer-events: none;
  }

  .barn-glow {
    position: absolute;
    /*
     * Centers the glow on the barn: barn's own right offset (6%) plus half
     * the barn's width minus half the glow's own 132px. Below ~500px the
     * barn (min(300px,26vw)) shrinks past 132px, so the raw calc goes
     * negative — a negative `right` pushes this box's right edge past the
     * container's right edge, which is exactly what forced the page to
     * scroll horizontally at 320px. max(0px, ...) keeps the glow pinned to
     * the barn's right edge instead of overshooting past it once the barn
     * is smaller than the glow itself.
     */
    right: max(0px, calc(6% + min(300px, 26vw) / 2 - 66px));
    bottom: calc(26% + min(300px, 26vw) * 0.62 - 66px);
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(247, 228, 176, 0.72) 0%,
      rgba(243, 196, 76, 0.34) 36%,
      rgba(243, 196, 76, 0) 70%
    );
  }

  /* Responsive first pass (docs/shep-design/README.md, "Responsive": "scenery
     reduced to a band rather than removed"). The sheep/dog footprints are
     already fluid (the clamp() widths above), so this only tightens the
     hill band on short mobile viewports. */
  @media (max-width: 600px) {
    .far-hill,
    .near-hill {
      height: 22vh;
    }

    .fence {
      bottom: 4vh;
    }
  }

  /*
   * Parallax (build 4) — THE SPEED MODEL.
   *
   * Scroll on this page is the passage of time, so the sky is choreographed
   * as a time-lapse rather than as generic lag: the stars linger and
   * dissolve into first light, the moon hangs pale into the morning before
   * fading, the sun climbs slowly off the hills and hangs through the day
   * scenes, and every cloud runs at its own depth-scaled speed. Depth comes
   * from the SPREAD of those speeds — build 2's mistake was giving every
   * layer the same drift, which reads as one slightly-slow background.
   *
   * Every drifting element moves at a UNIFORM fraction r of content speed
   * for as long as it is on screen. Builds 2-3 proved the two naive routes
   * both fail: scroll(root) drift diluted over the whole ~7-viewport page
   * is invisible (18vh of drift = ~25px per screenful), and a plain view()
   * drift is spent inside one viewport-crossing, so the element crawls and
   * then snaps back to full speed partway up the screen. The fix is to
   * stretch each animation's window to exactly the element's SLOWED time on
   * screen, so the drift rate is constant and the animation completes just
   * as the element leaves — no kink, no dilution:
   *
   *     on-screen span at 1x = S  (in vh of scroll)
   *     window = S / r            drift = S * (1 - r) / r
   *
   * Two timelines, split by where the element starts:
   *
   * - Starts below the fold (sun, clouds 2-5): animation-timeline: view()
   *   with animation-range `cover 0% cover (100/r)%`. S is one viewport
   *   plus the element's own height; the height term is deliberately
   *   dropped (S = 100vh) so the drift errs a few percent SMALL — the
   *   animation then finishes just after the element exits (invisible)
   *   instead of just before (a visible speed-up at the top edge).
   *
   * - Visible at scroll 0 (stars, moon, first cloud): a view() timeline
   *   would already be partially elapsed at load, and fill:both would
   *   displace them from their authored positions before any scrolling
   *   happens. They run on animation-timeline: scroll(root) with an
   *   explicit `0% <S/r>` range instead — S is the element's document
   *   bottom edge in vh, and at scroll 0 the range's progress is exactly
   *   0, so the load composition holds.
   *
   * Numbers in play (r, S -> range, drift):
   *
   *     stars   r 0.30, S 36vh -> range 120vh,       drift  84vh, fades
   *     moon    r 0.10, S 17vh -> range 170vh,       drift 153vh, fades
   *     sun     r 0.45         -> range cover 222%,  drift 122vh, eased
   *     clouds  r per instance -> cloudMotion() in the frontmatter
   *
   * The stars and moon also FADE (the sky-drift-fade* keyframes — stars
   * across the back 45% of their range, the moon over 25%-65%, timed to
   * its own slower departure) — that is what turns "slow parallax" into
   * "swallowed by the dawn", and it forgives the S estimates above: a star
   * field that lingers a touch long is invisible before it could clash
   * with the day sky. The sun instead gets an ease-out timing function:
   * the drift is spent fastest at the start, where it cancels the most
   * scroll, so the sun sits nearly still at the hilltop at first light and
   * accelerates away toward noon. (The curve's initial slope times
   * drift/window must stay below 1 or the sun would visibly move DOWN
   * while the page scrolls; the pair below has it rising at ~0.2x off the
   * horizon: slope 0.5/0.3 = 1.67, drift/window = 122/249 = 0.49.)
   *
   * Gates: every scroll-driven rule sits behind @supports
   * (animation-timeline: ...) so browsers without scroll-driven animations
   * (Firefox at this build) get the static 1x sky — never a stuck offset —
   * while still getting every time-based ambient (twinkle, wind sway,
   * shooting stars, glow breathing). Everything, ambient included, sits
   * behind reduced-motion, same as motion.css.
   */
  @media (prefers-reduced-motion: no-preference) {
    .cloud svg {
      animation: wind-sway var(--wind-duration, 24s) ease-in-out infinite;
      animation-delay: var(--wind-delay, 0s);
    }

    .shooting-star {
      animation: shoot var(--shoot-duration, 12s) linear infinite;
      animation-delay: var(--shoot-delay, 0s);
    }

    .sun::before {
      animation: glow-breathe 7s ease-in-out infinite;
    }

    .moon::before {
      animation: glow-breathe 9s ease-in-out infinite;
      animation-delay: -3.5s;
    }

    @supports (animation-timeline: scroll()) {
      /*
       * Deliberately longhand, not the `animation` shorthand: Astro's CSS
       * minifier (Lightning CSS) folds a shorthand `animation` declaration
       * plus a separate `animation-timeline` into one shorthand value, and
       * as of this build it produces `animation:linear both sky-parallax
       * scroll(root)`, a value the browser itself then rejects as invalid,
       * silently dropping the whole declaration (confirmed via the CSSOM:
       * the compiled rule's selector survives, its body is empty). The
       * longhand properties do not hit that merge path. animation-range is
       * kept out of any shorthand for the same reason. (The time-based
       * ambients above may use the shorthand: they set no timeline, so
       * there is nothing for the minifier to fold in.)
       *
       * Shared base for every scroll-driven element. view() support always
       * ships alongside scroll() support, so the .sun/.cloud members of
       * this list getting their animation-name in the view() block below
       * is not a real split — and either way, a base with no name is a
       * no-op.
       */
      .stars,
      .moon,
      .sun,
      .cloud,
      .mist {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .stars {
        animation-name: sky-drift-fade;
        animation-timeline: scroll(root);
        animation-range: 0% 120vh;
        --parallax-drift: 84vh;
      }

      .moon {
        /* The early-fade profile, not sky-drift-fade: at 0.1x the moon has
           crawled fully above the viewport by ~55% of its range, so the
           stars' back-45% fade would play out offscreen. 25%-65% dissolves
           the disc exactly across its visible departure into the dawn. */
        animation-name: sky-drift-fade-early;
        animation-timeline: scroll(root);
        animation-range: 0% 170vh;
        --parallax-drift: 153vh;
      }

      .cloud.at-top {
        animation-name: sky-drift;
        animation-timeline: scroll(root);
        animation-range: 0% var(--parallax-range, 100vh);
      }

      /* The fog reads overall page progress: its subject (the sticky
         pasture) is always on screen, so view() would be meaningless — the
         whole scroll range IS its dawn-and-burn-off day. */
      .mist {
        animation-name: mist-cycle;
        animation-timeline: scroll(root);
      }
    }

    @supports (animation-timeline: view()) {
      .sun {
        animation-name: sky-drift;
        animation-timeline: view();
        animation-range: cover 0% cover 222%;
        animation-timing-function: cubic-bezier(0.3, 0.5, 0.6, 1);
        --parallax-drift: 122vh;
      }

      .cloud:not(.at-top) {
        animation-name: sky-drift;
        animation-timeline: view();
        animation-range: cover 0% cover var(--parallax-range-end, 150%);
      }
    }
  }

  @keyframes sky-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(var(--parallax-drift, 0vh));
    }
  }

  /*
   * Drift plus a fade across the back 45%. The 55% keyframe must pin the
   * transform to 0.55 * drift by hand — an intermediate keyframe that only
   * declared opacity would still restart the transform's interpolation
   * there, and with any non-linear timing the drift rate would visibly
   * change at the seam. Linear timing only, for the same reason.
   */
  @keyframes sky-drift-fade {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    55% {
      transform: translateY(calc(var(--parallax-drift, 0vh) * 0.55));
      opacity: 1;
    }
    to {
      transform: translateY(var(--parallax-drift, 0vh));
      opacity: 0;
    }
  }

  /* Same construction, tuned for the moon (see its rule above): hold to
     25%, gone by 65%, transform hand-pinned at both seams. */
  @keyframes sky-drift-fade-early {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    25% {
      transform: translateY(calc(var(--parallax-drift, 0vh) * 0.25));
      opacity: 1;
    }
    65% {
      transform: translateY(calc(var(--parallax-drift, 0vh) * 0.65));
      opacity: 0;
    }
    to {
      transform: translateY(var(--parallax-drift, 0vh));
      opacity: 0;
    }
  }

  @keyframes wind-sway {
    from,
    to {
      transform: translateX(calc(var(--wind-amp, 10px) * -1));
    }
    50% {
      transform: translateX(var(--wind-amp, 10px));
    }
  }

  @keyframes shoot {
    0% {
      transform: translate3d(0, 0, 0) rotate(-33deg);
      opacity: 0;
    }
    3% {
      opacity: 0.9;
    }
    10% {
      transform: translate3d(-190px, 123px, 0) rotate(-33deg);
      opacity: 0;
    }
    100% {
      transform: translate3d(-190px, 123px, 0) rotate(-33deg);
      opacity: 0;
    }
  }

  /*
   * Opacity only — deliberately NO transform. A time-based scale on these
   * ::before glows, whose parents carry a scroll-driven transform of their
   * own, hit a Chromium compositing bug during verification: with the sun
   * on screen the page rendered blank in the capture path. Pulsing opacity
   * reads the same and composites cleanly.
   */
  @keyframes glow-breathe {
    from,
    to {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  /* Percentages are of the whole scroll: fog on the pasture from before
     first light, thickest as the dawn band crosses, burned off by the time
     the sky turns full blue. */
  @keyframes mist-cycle {
    0% {
      opacity: 0.55;
    }
    20% {
      opacity: 0.75;
    }
    38% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>
