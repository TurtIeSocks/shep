---
/*
 * The landing page's structural trick (docs/shep-design/README.md,
 * "Landing page > Structure" table + the top-level "THE STRUCTURAL TRICK"
 * note). One relative wrapper holds, in z-order:
 *
 *   0  fixed sky gradient spanning the whole stage (night -> dawn -> noon)
 *   1  stars / moon / sun / sheep-clouds, positioned in vh down the stage
 *   2  a STICKY pasture (position:sticky; top:0; height:100vh;
 *      margin-bottom:-100vh) so the scenery pins while content scrolls
 *   3  a night wash that multiplies over the top and fades out
 *   4  a barn glow, second sticky layer
 *   5+ <slot /> — the five content scenes and the lexicon section, which
 *      must live INSIDE this same wrapper: the stage's total height (driven
 *      by that slotted content) is what the sticky pasture pins against.
 *
 * Nothing here animates on scroll — the only scroll effect is this fixed
 * gradient being revealed behind the sticky scenery as the page moves.
 */
import Sheep from "../marks/Sheep.astro";
import Dog from "../marks/Dog.astro";
import Barn from "../marks/Barn.astro";

const stars = [
  [8, 14, 3, 3.1], [16, 38, 2, 4.2], [24, 8, 2.5, 2.6], [33, 24, 3, 3.8], [41, 7, 2, 4.6],
  [49, 30, 2.5, 3.2], [57, 13, 3, 2.9], [64, 35, 2, 4.1], [72, 9, 2.5, 3.5], [79, 27, 3, 2.7],
  [86, 16, 2, 4.4], [92, 38, 2.5, 3.3], [12, 52, 2, 3.9], [68, 56, 2.5, 4.8],
  [37, 62, 2, 3.4], [83, 66, 2.5, 4.1], [22, 72, 2, 3.7], [58, 78, 2, 4.5],
].map(([x, y, d, dur]) => ({ x, y, d, dur }));

const posts = [30, 180, 330, 480, 630, 780, 930, 1080, 1230, 1350];

/*
 * Clouds used to sit at raw viewport percentages, so at ordinary widths
 * (below ~1240px, where .inner's max-width isn't yet centering the page)
 * they landed inside the scene column's own horizontal span and hid behind
 * the lede. left/right below are no longer viewport-relative: `.clouds`
 * (see its rule below) is inset from the LEFT by --col-right, the widest
 * scene column's actual right edge at the current width, computed with the
 * same max-width/columnWidth math SceneSection.astro uses. So these
 * percentages are of the safe zone to the right of every scene's text, and
 * a cloud can never land under copy at any width.
 */
const clouds = [
  { left: "6%", top: "52vh", width: "150px" },
  { right: "18%", top: "128vh", width: "112px" },
  { left: "38%", top: "262vh", width: "184px" },
  { right: "10%", top: "332vh", width: "132px" },
  { left: "20%", top: "392vh", width: "96px" },
];

/*
 * Depth for the grazing sheep: far/mid/near controls width (a clamp() in
 * the stylesheet, not a fixed px, so the footprint itself shrinks with the
 * viewport instead of only its position), walk speed, height against the
 * hill, and z-index (the far sheep paints behind .fence — see that rule).
 * left/bottom are home positions; --walk-amp is how far each one wanders
 * from home before turning back (see the `walk` keyframes in motion.css).
 * These lanes plus the dog's fixed spot were checked against each other at
 * 320px — the tightest width, since every sheep's clamp() is pinned to its
 * min there — with a positive clearance margin at every boundary; wider
 * viewports only add more room. See the .depth-* / .watch-dog rules below.
 */
const grazing = [
  {
    depth: "far",
    left: "10%",
    bottom: "16vh",
    width: 52,
    bobDuration: "6.8s",
    bobDelay: ".3s",
    chewing: false,
    walkAmp: "2.5vw",
    walkDuration: "34s",
    walkDelay: "0s",
  },
  {
    depth: "mid",
    left: "30%",
    bottom: "8vh",
    width: 72,
    bobDuration: "5.6s",
    bobDelay: ".8s",
    chewing: true,
    walkAmp: "2vw",
    walkDuration: "24s",
    walkDelay: "1.4s",
  },
  {
    depth: "near",
    left: "52%",
    bottom: "2vh",
    width: 92,
    bobDuration: "4.8s",
    bobDelay: "0s",
    chewing: false,
    walkAmp: "2.5vw",
    walkDuration: "17s",
    walkDelay: "2.6s",
  },
];
---

<div class="stage">
  <div class="sky-gradient"></div>

  <div class="stars">
    {stars.map((s) => (
      <span
        class="star anim-twinkle"
        style={`left:${s.x}%;top:${s.y}%;width:${s.d}px;height:${s.d}px;--twinkle-duration:${s.dur}s;`}
      />
    ))}
  </div>

  <div class="moon">
    <span class="crater" style="left:16px;top:22px;width:13px;height:13px;" />
    <span class="crater" style="left:42px;top:16px;width:9px;height:9px;" />
    <span class="crater" style="left:34px;top:44px;width:16px;height:16px;" />
  </div>

  <div class="sun" aria-hidden="true"></div>

  <div class="clouds">
    {clouds.map((c) => (
      <div
        class="cloud"
        style={`${c.left ? `left:${c.left};` : `right:${c.right};`}top:${c.top};width:${c.width};`}
      >
        <svg viewBox="0 0 104 78" width="100%" aria-hidden="true">
          <path
            d="M40 20c6-9 22-10 28-2 10-3 19 4 18 13 7 4 7 15-1 19-2 8-12 11-19 8-8 5-21 4-26-3-10 1-17-7-15-16-4-8 4-18 15-19Z"
            fill="var(--fleece)"
            stroke="var(--ink)"
            stroke-width="3.4"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    ))}
  </div>

  <div class="pasture" aria-hidden="true">
    <div class="far-hill">
      <svg viewBox="0 0 1200 210" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 118C170 62 360 132 560 104 760 76 950 30 1200 84V210H0Z"
          fill="var(--illus-far-hill)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="barn">
      <Barn width={300} />
    </div>

    <div class="near-hill">
      <svg viewBox="0 0 1200 260" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 92C220 52 470 116 700 88 930 60 1050 96 1200 70V260H0Z"
          fill="var(--grass)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="fence">
      <svg viewBox="0 0 1400 76" preserveAspectRatio="none" width="100%" height="100%">
        <g fill="var(--fleece)" stroke="var(--ink)" stroke-width="4">
          <rect x="0" y="22" width="1400" height="12" rx="3" />
          <rect x="0" y="48" width="1400" height="12" rx="3" />
          {posts.map((a) => <path d={`M${a} 74V14l14-10 14 10v60Z`} />)}
        </g>
      </svg>
    </div>

    {grazing.map((sheep) => (
      <div
        class={`grazing-sheep depth-${sheep.depth} anim-walk`}
        style={`left:${sheep.left};bottom:${sheep.bottom};--walk-amp:${sheep.walkAmp};--walk-duration:${sheep.walkDuration};--walk-delay:${sheep.walkDelay};`}
      >
        <Sheep
          width={sheep.width}
          bob
          bobDuration={sheep.bobDuration}
          bobDelay={sheep.bobDelay}
          chewing={sheep.chewing}
        />
      </div>
    ))}

    <div class="watch-dog">
      <Dog width={126} wag />
    </div>
  </div>

  <div class="night-wash"></div>

  <div class="barn-glow-layer">
    <div class="barn-glow"></div>
  </div>

  <slot />
</div>

<style>
  .stage {
    position: relative;
    /*
     * Mirrors SceneSection.astro's own layout math (.inner's max-width and
     * padding, and the widest columnWidth of the five scenes — Scene2's
     * min(660px,56vw)) so --col-right always lands on the actual right edge
     * of the widest scene column at the current viewport width. Anything
     * placed at left:var(--col-right) or further right is guaranteed clear
     * of every scene's copy, at every width, instead of by coincidence.
     */
    --inner-max: 1240px;
    --inner-pad: 28px;
    --col-cap: 660px;
    --col-vw: 56vw;
    --inner-left: max(
      var(--inner-pad),
      calc((100vw - var(--inner-max)) / 2 + var(--inner-pad))
    );
    --col-right: calc(var(--inner-left) + min(var(--col-cap), var(--col-vw)));
  }

  @media (max-width: 680px) {
    /* SceneSection.astro forces every column to min(92vw,520px) below this
       same breakpoint — match it so --col-right stays accurate. */
    .stage {
      --col-cap: 520px;
      --col-vw: 92vw;
    }
  }

  .sky-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      180deg,
      #0e1730 0%,
      #152342 4.8%,
      #26386a 10.2%,
      #4c4a83 15%,
      #8c5f84 19.1%,
      #c97a5a 23.2%,
      #e7a468 27.3%,
      #f1c98d 31.4%,
      #dde6e0 36.8%,
      #bfe2f2 43.6%,
      #9bd8f1 51.8%,
      #b9e5f7 60%,
      #cfebf8 68.2%,
      #cfebf8 100%
    );
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 36vh;
    z-index: 1;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--fleece);
  }

  .moon {
    position: absolute;
    left: 17%;
    top: 9vh;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--illus-moon);
    border: 4px solid var(--line);
    box-shadow: 5px 5px 0 rgba(14, 23, 48, 0.35);
    z-index: 1;
  }

  .crater {
    position: absolute;
    border-radius: 50%;
    background: var(--illus-moon-craters);
    display: block;
  }

  .sun {
    position: absolute;
    left: 60%;
    top: 224vh;
    width: 124px;
    height: 124px;
    border-radius: 50%;
    background: var(--butter);
    border: 4px solid var(--line);
    box-shadow: 6px 6px 0 rgba(23, 37, 28, 0.16);
    z-index: 1;
  }

  .clouds {
    position: absolute;
    inset: 0;
    left: var(--col-right);
    z-index: 1;
  }

  .cloud {
    position: absolute;
  }

  /* Below 680px the scene column claims up to 92vw (SceneSection.astro's
     own mobile override) — there's no honest lane left for a cloud beside
     the text, so hide them deliberately rather than let them get trapped
     under copy again. Sun/moon/stars aren't scene-column-relative and are
     unaffected. */
  @media (max-width: 680px) {
    .clouds {
      display: none;
    }
  }

  .pasture {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
  }

  .far-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 8%;
    height: 43vh;
  }

  .near-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 0;
    height: 27vh;
  }

  .fence {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: 7vh;
    height: 54px;
    /* Above the hills' implicit stacking order but below the near/mid sheep
       and dog (z-index 3) — the far sheep (z-index 1) sits behind this on
       purpose, so it reads as grazing on the other side of the fence. */
    z-index: 2;
  }

  .barn {
    position: absolute;
    right: 6%;
    bottom: 26%;
    width: min(300px, 26vw);
  }

  /* Barn.astro sizes its own wrapper from the `width` prop (a fixed px
     figure for a standalone mark); here it must instead fill this
     already-responsive min(300px,26vw) container. */
  .barn :global(.barn-mark) {
    width: 100% !important;
  }

  .grazing-sheep {
    position: absolute;
  }

  /*
   * Depth: width is a clamp() rather than the Sheep.astro `width` prop's
   * fixed px, so the footprint itself shrinks with the viewport (same fix
   * as the clouds) instead of only its position — a fixed-px sheep next to
   * a percentage lane is exactly how bug 2 happened. Further-away sheep are
   * also smaller, higher up (bigger `bottom`, set inline per-instance),
   * slower to walk, and desaturated/brightened to lose contrast against the
   * hill, plus the far one paints behind .fence (z-index 1 < fence's 2).
   */
  .depth-far {
    z-index: 1;
    filter: saturate(0.58) brightness(1.07) opacity(0.85);
  }

  .depth-far :global(.sheep-mark) {
    width: clamp(34px, 4.4vw, 58px) !important;
  }

  .depth-mid {
    z-index: 3;
  }

  .depth-mid :global(.sheep-mark) {
    width: clamp(48px, 6.2vw, 84px) !important;
  }

  .depth-near {
    z-index: 3;
  }

  .depth-near :global(.sheep-mark) {
    width: clamp(60px, 8vw, 108px) !important;
  }

  .watch-dog {
    position: absolute;
    right: 6%;
    bottom: 4vh;
    z-index: 3;
  }

  .watch-dog :global(.dog-mark) {
    width: clamp(56px, 9.4vw, 126px) !important;
  }

  .night-wash {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: multiply;
    background: linear-gradient(
      180deg,
      rgba(16, 26, 52, 0.72) 0%,
      rgba(16, 26, 52, 0.66) 8.2%,
      rgba(22, 34, 64, 0.5) 15%,
      rgba(40, 40, 72, 0.3) 20.5%,
      rgba(90, 70, 60, 0.12) 25.9%,
      rgba(255, 255, 255, 0) 32.7%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .barn-glow-layer {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    z-index: 4;
    pointer-events: none;
  }

  .barn-glow {
    position: absolute;
    /*
     * Centers the glow on the barn: barn's own right offset (6%) plus half
     * the barn's width minus half the glow's own 132px. Below ~500px the
     * barn (min(300px,26vw)) shrinks past 132px, so the raw calc goes
     * negative — a negative `right` pushes this box's right edge past the
     * container's right edge, which is exactly what forced the page to
     * scroll horizontally at 320px. max(0px, ...) keeps the glow pinned to
     * the barn's right edge instead of overshooting past it once the barn
     * is smaller than the glow itself.
     */
    right: max(0px, calc(6% + min(300px, 26vw) / 2 - 66px));
    bottom: calc(26% + min(300px, 26vw) * 0.62 - 66px);
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(247, 228, 176, 0.72) 0%,
      rgba(243, 196, 76, 0.34) 36%,
      rgba(243, 196, 76, 0) 70%
    );
  }

  /* Responsive first pass (docs/shep-design/README.md, "Responsive": "scenery
     reduced to a band rather than removed"). The sheep/dog footprints are
     already fluid (the clamp() widths above), so this only tightens the
     hill band on short mobile viewports. */
  @media (max-width: 600px) {
    .far-hill,
    .near-hill {
      height: 22vh;
    }

    .fence {
      bottom: 4vh;
    }
  }

  /*
   * Parallax (build 3): the sky layer scrolls at 1x today because it's an
   * absolutely-positioned child of the tall .stage, same as the copy below
   * it. animation-timeline: scroll(root) drives a small, growing translateY
   * off of overall page scroll progress with no JS — it partially cancels
   * the sky's normal upward scroll, so it visibly lags the text. Gated
   * behind @supports so unsupported browsers (no scroll-driven animation
   * support yet in Firefox/older Safari) get zero transform applied, i.e.
   * today's plain 1x scroll — never a stuck offset from an animation that
   * ran once at time 0. Also gated behind reduced-motion, same as every
   * other animation on this page.
   *
   * Build 2 gave every layer the same 10vh of drift across the whole page,
   * which reads as a slightly slower background, not depth — depth needs
   * layers to move at DIFFERENT rates. All four share one keyframe (still
   * longhand only, see the note below on why) and each layer sets its own
   * --parallax-drift: stars and moon are the farthest things in the scene
   * and barely move; clouds sit lower and nearer and drift noticeably; the
   * sun is the nearest, lowest object of the four (it rises across the
   * pasture's own scenery band rather than sitting fixed in a far sky) and
   * gets the most drift of the group.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .stars,
      .moon,
      .sun,
      .clouds {
        /*
         * Deliberately longhand, not the `animation` shorthand: Astro's CSS
         * minifier (Lightning CSS) folds a shorthand `animation` declaration
         * plus a separate `animation-timeline` into one shorthand value, and
         * as of this build it produces `animation:linear both sky-parallax
         * scroll(root)` — a value the browser itself then rejects as
         * invalid, silently dropping the whole declaration (confirmed via
         * the CSSOM: the compiled rule's selector survives, its body is
         * empty). Longhand properties don't hit that merge path.
         */
        animation-name: sky-parallax;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }

      .stars {
        --parallax-drift: 4vh;
      }

      .moon {
        --parallax-drift: 7vh;
      }

      .clouds {
        --parallax-drift: 18vh;
      }

      .sun {
        --parallax-drift: 26vh;
      }
    }
  }

  @keyframes sky-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(var(--parallax-drift, 10vh));
    }
  }
</style>
