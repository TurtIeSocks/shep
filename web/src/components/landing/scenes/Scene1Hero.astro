---
/*
 * Scene 1 — the hero. Copy verbatim from docs/shep-design/README.md,
 * "Screens > 1. Landing page > Scene copy" #1.
 */
import SceneSection from "../SceneSection.astro";
import CopyCloneButton from "../CopyCloneButton.astro";
---

<SceneSection id="scene-1">
  <div class="eyebrow">A process manager written in Rust</div>
  <h1 class="headline">shep keeps<br />your flock<br />alive.</h1>
  <p class="lede">
    One binary runs a daemon called the shepherd. It restarts your processes
    when they die, captures what they print, and says plainly when something
    is wrong.
  </p>
  <div class="actions">
    <a href="/docs" class="get-started press" style="--shadow-offset:6px; --press-offset:3px;">
      Get started →
    </a>
    <CopyCloneButton />
  </div>
  <div class="scroll-hint">scroll — the sun comes up ↓</div>
</SceneSection>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--butter);
    color: var(--ink);
    border: 3px solid var(--line);
    border-radius: 999px;
    padding: 8px 16px;
    box-shadow: 4px 4px 0 var(--shadow);
    margin-bottom: 18px;
    white-space: nowrap;
  }

  .headline {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.87;
    letter-spacing: -0.055em;
    margin: 0 0 20px;
    color: var(--fleece);
    text-shadow: 5px 5px 0 rgba(14, 23, 48, 0.45);
  }

  .lede {
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 42ch;
    margin: 0 0 24px;
    font-weight: 500;
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 18px;
    padding: 16px 20px;
    box-shadow: 5px 5px 0 var(--shadow);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    align-items: center;
  }

  .get-started {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 17px;
    background: var(--grass-deep);
    color: var(--fleece);
    border: 3px solid var(--line);
    border-radius: 16px;
    padding: 15px 26px;
    text-decoration: none;
  }

  .scroll-hint {
    margin-top: 30px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(255, 253, 245, 0.92);
    border: 3px solid var(--line);
    border-radius: 999px;
    padding: 8px 16px;
    box-shadow: 3px 3px 0 var(--shadow);
    color: var(--ink);
  }
</style>
