---
/*
 * Scene 5, pre-release, honestly. Copy originally verbatim from
 * docs/shep-design/README.md, "Screens > 1. Landing page > Scene copy" #5;
 * updated 2026-08-16 ahead of the first publish to carry the
 * `cargo install` command instead of "not on crates.io", matching
 * README.md's own status block. The version is deliberately not repeated
 * here: it would be one more place to bump, and the install command no
 * longer needs to name one. docs/shep-design/README.md is left as the
 * original design handoff record and was not edited to match.
 */
import SceneSection from "../SceneSection.astro";
---

<SceneSection id="scene-5" columnWidth="min(580px, 50vw)">
  <div class="card">
    <div class="kicker-row">
      <span class="chip">pre-release</span>
      <span class="kicker-label">and honest about it</span>
    </div>
    <p>
      Early days, and pre-1.0 means anything can still change. Install
      with <code>cargo install shep</code> and it runs on macOS, Linux and
      Windows. The Windows tier is the newest of the three, and it refuses
      two things out loud rather than papering over them: a graceful
      <code>stop</code> for an app that has not opted into the shepherd
      channel, and <code>shep startup</code>.
    </p>
    <a href="#chalkboard" class="cta press" style="--shadow-offset:5px; --press-offset:2px;">
      See exactly what's missing
    </a>
  </div>
</SceneSection>

<style>
  .card {
    background: var(--paper-2);
    border: 4px solid var(--bark);
    border-radius: 26px;
    box-shadow: 9px 9px 0 var(--shadow);
    padding: 32px;
    transform: rotate(-0.8deg);
  }

  .kicker-row {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 14px;
  }

  .chip {
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--bark);
    color: var(--fleece);
    border: 2.5px solid var(--line);
    border-radius: 8px;
    padding: 5px 10px;
  }

  .kicker-label {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 18px;
    color: var(--ink);
  }

  p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  p code {
    font-family: "Space Mono", monospace;
    font-size: 14.5px;
  }

  .cta {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 16px;
    background: var(--bark);
    color: var(--fleece);
    border: 3px solid var(--line);
    border-radius: 14px;
    padding: 14px 22px;
    text-decoration: none;
    display: inline-block;
  }
</style>
