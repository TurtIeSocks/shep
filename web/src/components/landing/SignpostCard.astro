---
/*
 * One lexicon signpost card (docs/shep-design/README.md, "Screens >
 * 1. Landing page > Lexicon"). Content comes from web/src/data/lexicon.ts.
 */
import type { LexiconSignpost } from "../../data/lexicon";

interface Props extends LexiconSignpost {}

const { term, meaning, cli, bg, fg, tilt } = Astro.props;
---

<div class="signpost-wrap">
  <div class="post" aria-hidden="true"></div>
  {/* background-color, never the background shorthand: the shorthand
      would reset the stylesheet's plank background-image layers. */}
  <div class="card" style={`background-color:${bg};transform:rotate(${tilt});`}>
    <div class="screws">
      <span></span>
      <span></span>
    </div>
    <div class="term" style={`color:${fg}`}>{term}</div>
    <div class="meaning" style={`color:${fg}`}>{meaning}</div>
    <div class="cli" style={`color:${fg}`}>{cli}</div>
  </div>
</div>

<style>
  .signpost-wrap {
    position: relative;
    padding-top: 26px;
  }

  .post {
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 30px;
    background: var(--ink);
    transform: translateX(-50%);
    border-radius: 3px;
  }

  .card {
    border: 4px solid var(--line);
    border-radius: 20px;
    box-shadow: 6px 6px 0 var(--shadow);
    padding: 22px 24px;
    /*
     * Painted wooden sign: the data-driven background color stays as the
     * paint, and two low-alpha layers draw the boards over it — a dark
     * seam every 38px, and a soft highlight right under each seam so the
     * boards read bevelled. (A third vertical saw-mark layer was tried
     * and cut: crossing lines read as graph paper, not wood.) The seam and
     * highlight layers share the 38px period so they can't drift apart
     * down a tall card. (Features.astro's cards use the same recipe over
     * cream — change one, change the other.)
     */
    background-image:
      repeating-linear-gradient(
        180deg,
        rgba(23, 37, 28, 0) 0 35px,
        rgba(23, 37, 28, 0.18) 35px 38px
      ),
      repeating-linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.16) 0 4px,
        rgba(255, 255, 255, 0) 8px 38px
      );
  }

  .screws {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .screws span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    display: block;
  }

  .term {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 23px;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .meaning {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.9;
  }

  .cli {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.62;
    margin-top: 12px;
  }
</style>
