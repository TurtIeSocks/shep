---
/*
 * Design-language header (docs/shep-design/README.md, "Screens > 3.
 * Design language"). Logo lockup (sheep mark, "shep", "design language
 * v1.0") on the left, the label-variant theme toggle on the right — the
 * same ThemeToggle component and shep-theme localStorage key the docs
 * pages use, not a rebuilt one.
 */
import Sheep from "../marks/Sheep.astro";
import ThemeToggle from "../ThemeToggle.astro";
---

<header class="dl-header">
  <a href="/" class="lockup">
    <Sheep width={40} />
    <div>
      <div class="wordmark">shep</div>
      <div class="version">design language v1.0</div>
    </div>
  </a>
  <ThemeToggle variant="label" />
</header>

<style>
  .dl-header {
    max-width: 1180px;
    margin: 0 auto;
    padding: 34px 32px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .version {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 4px;
  }
</style>
