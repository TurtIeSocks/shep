---
/*
 * 05 Shape and motion (docs/shep-design/README.md, "Screens > 3. Design
 * language"). A shape-rules card with live specimens (border/radius/
 * shadow/tilt token values, not redrawn), a motion table where each row
 * carries a REAL running instance of that keyframe/utility from
 * ../../styles/motion.css and the Sheep/Dog mark components — not a static
 * description of what the animation does — and a scenery-rules card.
 */
import Sheep from "../marks/Sheep.astro";
import Dog from "../marks/Dog.astro";
import { shapeRules, motionRows, sceneryRules } from "../../data/designLanguage";
---

<section class="shape-motion">
  <div class="section-head">
    <span class="n">05</span>
    <h2>Shape and motion</h2>
  </div>
  <p class="lede">
    One outline weight, one shadow, no blur. Everything that moves is an
    idle loop — nothing animates in response to scrolling except the sky.
  </p>

  <div class="two-up">
    <div class="card">
      <div class="card-label">Shape</div>
      <div class="shape-rows">
        {
          shapeRules.map((sr) => (
            <div class="shape-row">
              <div class="specimen-stage">
                <span
                  class="specimen"
                  style={`width:${sr.w}; height:${sr.h}; background:${sr.fill}; border:${sr.border} solid var(--line); border-radius:${sr.radius}; box-shadow:${sr.shadow}; transform:rotate(${sr.tilt});`}
                />
              </div>
              <div>
                <div class="shape-name">{sr.name}</div>
                <div class="shape-rule">{sr.rule}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="card">
      <div class="card-label">Motion</div>
      <div class="motion-rows">
        {
          motionRows.map((m) => (
            <div class="motion-row">
              <div class="motion-demo" aria-hidden="true">
                {m.name === "bob" && <Sheep width={38} bob bobDuration="5.6s" />}
                {m.name === "chew" && <Sheep width={38} chewing />}
                {m.name === "wag" && <Dog width={46} wag />}
                {m.name === "twinkle" && <span class="star anim-twinkle">✦</span>}
                {m.name === "press" && (
                  <span
                    class="press-demo press"
                    style="--shadow-offset:3px; --press-offset:1px;"
                  >
                    hover
                  </span>
                )}
              </div>
              <div class="motion-name">{m.name}</div>
              <div>
                <div class="motion-what">{m.what}</div>
                <div class="motion-spec">{m.spec}</div>
              </div>
            </div>
          ))
        }
      </div>
      <p class="note">
        Give any two animals different durations and offset delays. Two
        sheep bobbing in lockstep reads as a loading spinner.
      </p>
    </div>
  </div>

  <div class="card scenery-card">
    <div class="card-label">Scenery</div>
    <div class="scenery-grid">
      {
        sceneryRules.map((sc) => (
          <div>
            <div class="scenery-name">{sc.name}</div>
            <p>{sc.rule}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .shape-motion {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 32px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 14px;
  }

  .section-head .n {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--bark);
  }

  .section-head h2 {
    font-size: 38px;
    letter-spacing: -0.03em;
  }

  .lede {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 32px;
  }

  .two-up {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 22px;
  }

  .card {
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 22px;
    box-shadow: 6px 6px 0 var(--shadow);
    padding: 28px;
  }

  .card-label {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 20px;
  }

  .shape-rows {
    display: grid;
    gap: 16px;
  }

  .shape-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
  }

  .specimen-stage {
    height: 56px;
    display: grid;
    place-items: center;
  }

  .shape-name {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 16px;
    margin-bottom: 3px;
  }

  .shape-rule {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .motion-rows {
    display: grid;
  }

  .motion-row {
    display: grid;
    grid-template-columns: 44px 74px minmax(0, 1fr);
    gap: 16px;
    padding: 13px 0;
    border-bottom: 2px solid var(--hair);
    align-items: center;
  }

  .motion-row:last-child {
    border-bottom: none;
  }

  .motion-demo {
    display: grid;
    place-items: center;
    height: 38px;
  }

  .star {
    font-size: 20px;
    color: var(--butter);
    line-height: 1;
    display: inline-block;
  }

  .press-demo {
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: 999px;
    padding: 5px 9px;
    cursor: pointer;
  }

  .motion-name {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--meadow);
  }

  .motion-what {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
  }

  .motion-spec {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    color: var(--ink-3);
    margin-top: 3px;
  }

  .note {
    margin: 18px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .scenery-card {
    margin-top: 22px;
  }

  .scenery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
  }

  .scenery-name {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 16px;
    margin-bottom: 6px;
  }

  .scenery-grid p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (max-width: 480px) {
    .motion-row {
      grid-template-columns: 36px minmax(0, 1fr);
    }

    .motion-name {
      grid-column: 2;
    }
  }
</style>
