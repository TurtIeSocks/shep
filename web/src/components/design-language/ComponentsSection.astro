---
/*
 * 04 Components (docs/shep-design/README.md, "Screens > 3. Design
 * language"). An ink band: buttons, status pills, a terminal block, and
 * two callouts. Buttons/pills reuse the shared `.press` utility from
 * motion.css instead of redeclaring the hover/shadow behavior.
 *
 * Terminal chrome (bg/border/text/muted) reuses tokens.css's
 * --illus-terminal-* tokens, defined for exactly this "terminal chrome"
 * case. The chrome dots and in-body colors read UI tokens (--bark,
 * --butter, --grass) rather than the mac-dot literals the original
 * handoff used, since those already carry the right meaning here (grass
 * is documented as "terminal success").
 */
import { statuses } from "../../data/designLanguage";
---

<section class="components-section">
  <div class="inner">
    <div class="section-head">
      <span class="n">04</span>
      <h2>Components</h2>
    </div>

    <div class="row-2">
      <div class="panel">
        <div class="panel-label">Buttons</div>
        <div class="buttons">
          <span
            class="btn press"
            style="background:var(--meadow); color:var(--paper-2); --shadow-offset:4px; --press-offset:2px;"
          >
            Build from source
          </span>
          <span
            class="btn press"
            style="background:var(--paper-2); color:var(--ink); --shadow-offset:4px; --press-offset:2px;"
          >
            Read the docs
          </span>
          <span class="text-link">the lexicon →</span>
        </div>
      </div>

      <div class="panel">
        <div class="panel-label">Status pills</div>
        <div class="pills">
          {
            statuses.map((s) => (
              <span
                class="pill"
                style={`background:${s.bg}; color:${s.fg};`}
              >
                {s.label}
              </span>
            ))
          }
        </div>
        <p class="note">
          Status text is the daemon's own word, lowercase, never restyled
          into a friendlier one.
        </p>
      </div>
    </div>

    <div class="row-2 row-2-wide">
      <div>
        <div class="panel-label light">Terminal block</div>
        <div class="terminal">
          <div class="chrome">
            <span class="dot" style="background:var(--bark);"></span>
            <span class="dot" style="background:var(--butter);"></span>
            <span class="dot" style="background:var(--grass);"></span>
            <span class="path">~/apps</span>
          </div>
          <div class="body">
            <div><span class="prompt">$</span> shep start Flockfile.toml</div>
            <div class="muted">shepherd not listening — starting one</div>
            <div><span class="ok">✓</span> web&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;online&nbsp;&nbsp; pid 1001</div>
            <div><span class="ok">✓</span> worker&nbsp;&nbsp;online&nbsp;&nbsp; pid 1002</div>
            <div><span class="bad">!</span> cron&nbsp;&nbsp;&nbsp;&nbsp;errored&nbsp; restart budget exhausted</div>
          </div>
        </div>
      </div>
      <div>
        <div class="panel-label light">Callouts</div>
        <div class="callouts">
          <div class="callout">
            <span class="tag" style="background:var(--butter); color:var(--ink);">note</span>
            <p>
              <code>shep logs</code> is the same command as
              <code>shep bleats</code>, and always will be.
            </p>
          </div>
          <div class="callout" style="border-color:var(--bark);">
            <span class="tag" style="background:var(--bark); color:var(--paper-2);">careful</span>
            <p>
              An adopted dog runs at the shepherd's own trust level, with no
              isolation beyond it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .components-section {
    background: var(--ink);
    border-top: 3px solid var(--line);
    border-bottom: 3px solid var(--line);
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 32px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 36px;
  }

  .section-head .n {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--butter);
  }

  .section-head h2 {
    font-size: 38px;
    letter-spacing: -0.03em;
    color: var(--paper);
  }

  .row-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 26px;
  }

  .row-2-wide {
    margin-top: 26px;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  }

  .panel {
    background: var(--paper);
    color: var(--ink);
    border-radius: 20px;
    padding: 26px;
    border: 3px solid var(--line);
  }

  .panel-label {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 18px;
  }

  .panel-label.light {
    color: var(--butter);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .btn {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 16px;
    border: 3px solid var(--line);
    border-radius: 14px;
    padding: 13px 22px;
    cursor: default;
    display: inline-block;
  }

  .text-link {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--meadow);
    border-bottom: 2.5px solid var(--meadow);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    font-family: "Space Mono", monospace;
    font-size: 12.5px;
    font-weight: 700;
    border: 2.5px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
  }

  .note {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 18px 0 0;
  }

  .terminal {
    background: var(--illus-terminal-bg);
    border: 3px solid var(--illus-terminal-border);
    border-radius: 18px;
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 2px solid var(--illus-terminal-border);
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }

  .path {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    color: var(--illus-terminal-muted);
    margin-left: 8px;
  }

  .terminal .body {
    padding: 20px;
    font-family: "Space Mono", monospace;
    font-size: 13px;
    line-height: 1.75;
    color: var(--illus-terminal-text);
    overflow-x: auto;
    white-space: pre;
  }

  .prompt,
  .ok {
    color: var(--grass);
  }

  .bad {
    color: var(--bark);
  }

  .muted {
    color: var(--illus-terminal-muted);
  }

  .callouts {
    display: grid;
    gap: 14px;
  }

  .callout {
    background: var(--paper);
    border: 3px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .tag {
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 12px;
    border: 2px solid var(--line);
    border-radius: 8px;
    padding: 3px 8px;
    white-space: nowrap;
  }

  .callout p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .callout code {
    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    background: var(--code-bg);
    border-radius: 5px;
    padding: 1px 6px;
  }
</style>
