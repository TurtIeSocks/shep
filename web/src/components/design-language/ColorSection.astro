---
/*
 * 02 Color (docs/shep-design/README.md, "Screens > 3. Design language").
 * Nine swatches on a paper-2 band. Every swatch fill is `background:
 * var(--token)` — never a stored hex — so it repaints correctly when the
 * theme toggle flips tokens.css's dark overrides. The hex text under each
 * name is read live from computed style by the script below, for the same
 * reason: a number typed here would go stale the first time a token's
 * value changes.
 *
 * Per the task brief: --barn and --bark's single-use rules are stated
 * right in their swatch's `use` text (designLanguage.ts), same as the
 * original handoff already did — nothing extra needed to surface them.
 */
import { swatches } from "../../data/designLanguage";
---

<section class="color-section">
  <div class="inner">
    <div class="section-head">
      <span class="n">02</span>
      <h2>Color</h2>
    </div>
    <p class="lede">
      Cream paper and ink carry every surface. Meadow is the only color that
      means "this works". The other four are earned: one for alerts, one
      for attention, one for reference, one for links.
    </p>
    <div class="swatches">
      {
        swatches.map((s) => (
          <div class="swatch">
            <div class="fill" style={`background:var(${s.cssVar});`} />
            <div class="meta">
              <div class="name">{s.name}</div>
              <div class="value" data-swatch-var={s.cssVar}>
                var({s.cssVar})
              </div>
              <div class="use">{s.use}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Reads each swatch's live computed color instead of trusting a stored
  // hex (see the header comment above). Re-runs on theme toggle by
  // watching <html data-theme>, so it never shows a value from the theme
  // that's no longer active.
  function syncSwatchValues() {
    const root = getComputedStyle(document.documentElement);
    document
      .querySelectorAll<HTMLElement>("[data-swatch-var]")
      .forEach((el) => {
        const varName = el.getAttribute("data-swatch-var");
        if (!varName) return;
        const value = root.getPropertyValue(varName).trim();
        el.textContent = `var(${varName}) · ${value}`;
      });
  }

  syncSwatchValues();
  new MutationObserver(syncSwatchValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .color-section {
    background: var(--paper-2);
    border-top: 3px solid var(--line);
    border-bottom: 3px solid var(--line);
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 32px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 36px;
  }

  .section-head .n {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--bark);
  }

  .section-head h2 {
    font-size: 38px;
    letter-spacing: -0.03em;
  }

  .lede {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 58ch;
    margin: 0 0 32px;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 18px;
  }

  .swatch {
    border: 3px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 5px 5px 0 var(--shadow);
    background: var(--paper);
  }

  .fill {
    height: 104px;
  }

  .meta {
    padding: 14px 16px;
    border-top: 3px solid var(--line);
  }

  .name {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 16px;
  }

  .value {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    color: var(--ink-3);
    margin: 3px 0 8px;
    word-break: break-all;
  }

  .use {
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
