---
/*
 * 06 Voice (docs/shep-design/README.md, "Screens > 3. Design language").
 * Four registers, yes/no columns, then a CTA card linking to the real
 * lexicon page. Same three standing rules as docs/terminology.md's "Usage
 * rules" — see designLanguage.ts's header comment for why this is
 * hand-curated rather than parsed.
 */
import { voiceRegisters } from "../../data/designLanguage";
---

<section class="voice-section">
  <div class="section-head">
    <span class="n">06</span>
    <h2>Voice</h2>
  </div>
  <p class="lede">
    Four registers, and knowing which one you are in is most of the job.
  </p>

  <div class="table">
    {
      voiceRegisters.map((r) => (
        <div class="row">
          <div>
            <div class="where">{r.where}</div>
            <div class="register" style={`color:${r.tone};`}>
              {r.register}
            </div>
          </div>
          <div class="yes">{r.yes}</div>
          <div class="no">{r.no}</div>
        </div>
      ))
    }
  </div>

  <div class="cta">
    <div>
      <h3>The lexicon is the design system too.</h3>
      <p>
        Fifteen words carry the whole product. Get them right and the
        interface explains itself; get them wrong and no amount of
        illustration saves it.
      </p>
    </div>
    <a href="/docs/terminology" class="cta-btn press" style="--shadow-offset:4px; --shadow-color:var(--paper-2); --press-offset:2px;">
      Read the lexicon →
    </a>
  </div>
</section>

<style>
  .voice-section {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 32px 90px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 14px;
  }

  .section-head .n {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--bark);
  }

  .section-head h2 {
    font-size: 38px;
    letter-spacing: -0.03em;
  }

  .lede {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 32px;
  }

  .table {
    display: grid;
    border: 3px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    background: var(--paper-2);
  }

  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1fr);
    gap: 22px;
    padding: 22px 26px;
    border-bottom: 2px solid var(--hair);
    align-items: start;
  }

  .row:last-child {
    border-bottom: none;
  }

  .where {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 18px;
  }

  .register {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 5px;
  }

  .yes,
  .no {
    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .yes {
    color: var(--meadow);
  }

  .no {
    color: var(--ink-3);
    text-decoration: line-through;
  }

  .cta {
    margin-top: 44px;
    background: var(--grass);
    border: 3px solid var(--line);
    border-radius: 24px;
    box-shadow: 8px 8px 0 var(--shadow);
    padding: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
  }

  .cta h3 {
    font-size: 30px;
    letter-spacing: -0.03em;
    margin: 0 0 10px;
    color: var(--ink);
  }

  .cta p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 52ch;
  }

  .cta-btn {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 17px;
    background: var(--ink);
    color: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 14px;
    padding: 15px 24px;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta-btn:hover {
    color: var(--paper-2);
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cta {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
