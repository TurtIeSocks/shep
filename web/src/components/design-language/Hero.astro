---
/*
 * Design-language hero (docs/shep-design/README.md, "Screens > 3. Design
 * language"). Eyebrow, h1, lede on the left; a "Three rules" card on the
 * right. Copy verbatim from design-files/Shep Design Language.dc.html.
 */
import { threeRules } from "../../data/designLanguage";
---

<section class="dl-hero">
  <div class="copy">
    <div class="eyebrow">The house style</div>
    <h1>Cute on the<br />outside. Exact<br />where it counts.</h1>
    <p>
      shep is a process manager written in Rust. The sheep are a mnemonic,
      not a costume — so the personality lives in prose, illustration and
      color, and drops out the moment a misread would cost someone a
      process.
    </p>
  </div>
  <div class="rules-card">
    <div class="rules-label">Three rules</div>
    <ol>
      {
        threeRules.map((rule) => (
          <li>
            <strong>{rule.title}</strong> {rule.body}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .dl-hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 32px 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px;
    align-items: end;
  }

  .eyebrow {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bark);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 78px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .copy p {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }

  .rules-card {
    background: var(--paper-2);
    border: 3px solid var(--line);
    border-radius: 22px;
    box-shadow: 7px 7px 0 var(--shadow);
    padding: 26px;
  }

  .rules-label {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }

  .rules-card ol {
    margin: 0;
    padding-left: 22px;
    display: grid;
    gap: 14px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .rules-card strong {
    color: var(--ink);
  }

  @media (max-width: 780px) {
    .dl-hero {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
